# ---------------------------------------------------------------
# Robcar Veículos — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione valores reais.
# Todas as variáveis VITE_* são embutidas no bundle público:
# não coloque aqui chaves privilegiadas (ex.: service_role).
# ---------------------------------------------------------------

# URL pública definitiva do site (canonical, Open Graph, sitemap). Sem barra final.
VITE_SITE_URL=https://robcar-veiculos.vercel.app

# "true" somente quando o site estiver com dados reais e domínio definitivo.
# Enquanto for diferente de "true", robots.txt bloqueia indexação e as páginas recebem noindex.
VITE_ALLOW_INDEXING=false

# WhatsApp comercial no formato internacional, só dígitos (padrão do projeto: 5518997841331).
# Sobrescreve o valor de src/config/site.ts.
VITE_WHATSAPP_NUMBER=

# Supabase (opcional). Sem estas variáveis o site usa os veículos de DEMONSTRAÇÃO
# e o painel administrativo fica indisponível.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mensuração (opcional). Sem IDs, nada é carregado.
# Se GTM estiver definido, ele tem prioridade e o GA4 deve ser configurado dentro do GTM.
VITE_GTM_ID=
VITE_GA4_ID=

# Ficha de financiamento (opcional). URL HTTPS de um backend AUTORIZADO que valide no
# servidor, controle acesso, proteja contra abuso e tenha política de retenção definida.
# Sem esta variável, a ficha NÃO envia nem armazena dados (apenas a interface).
VITE_FINANCING_ENDPOINT=
